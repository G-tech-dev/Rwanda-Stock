# MongoDB database connection (server-side only)
MONGODB_URI=
MONGODB_DB=rwanda_stock

# Flutterwave v3 credentials from your merchant dashboard (server-side only)
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# Public origin of this deployment, with no trailing slash
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app

# Monthly Rwanda Stock subscription amount in RWF; choose your price before enabling payments
RS_BUSINESS_MONTHLY_PRICE_RWF=
