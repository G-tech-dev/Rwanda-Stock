{
  "manifest_version": 3,
  "name": "Roulette Even/Odd Tracker",
  "version": "1.1.0",
  "description": "Track roulette results locally and scan the Winner Auto Roulette recent-results page.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://winner.rw/en/virtual/recently-played/autoroulette-1*"],
  "action": {
    "default_title": "Roulette Even/Odd Tracker",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://winner.rw/en/virtual/recently-played/autoroulette-1*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}