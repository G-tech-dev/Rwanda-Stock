{
  "manifest_version": 3,
  "name": "Roulette Even/Odd Tracker",
  "version": "1.7.0",
  "description": "Track roulette results locally and analyze experimental run-length inversion patterns.",
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "https://winner.rw/*",
    "https://*.groovegaming.com/*",
    "https://client.pragmaticplaylive.net/*"
  ],
  "action": {
    "default_title": "Roulette Even/Odd Tracker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://winner.rw/*",
        "https://*.groovegaming.com/*",
        "https://client.pragmaticplaylive.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}