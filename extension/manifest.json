{
  "manifest_version": 3,
  "name": "Roulette Even/Odd Tracker",
  "version": "1.2.0",
  "description": "Track roulette results locally and scan the Winner Auto Roulette recent-results page.",
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "https://winner.rw/en/virtual/recently-played/autoroulette-1*",
    "https://*.groovegaming.com/*"
  ],
  "action": {
    "default_title": "Roulette Even/Odd Tracker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://winner.rw/en/virtual/recently-played/autoroulette-1*",
        "https://gprouter.groovegaming.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
